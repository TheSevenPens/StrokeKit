<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The drawing core: strokes, brushes, surfaces, view mathematics, and the demo figures.
    Everything that puts a mark down, and nothing that explains one.

    Split out of StrokeFieldGuide so that an application can take the part it draws with
    without taking the book. The recorder needs Reading, Stroke, Surface, InkTransform and the
    brush types; it has no use for 48 pages, the check machinery, or the recorded corpus, and
    before this it had to reference all of them to get a stroke.

    The dependency runs one way and is meant to: the guide references this, and nothing here
    may reference the guide. That direction already held in the source before there were two
    projects; what changed is that the compiler now enforces it.
  -->

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>StrokeKit</RootNamespace>
    <AssemblyName>StrokeKit</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="$(SkiaSharpVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Reading and Leaning are stated in WinPenKit's terms, because a reading is what a pen
      session hands over and restating it here would be a second vocabulary for one thing.
    -->
    <ProjectReference Include="..\..\vendor\WinPenKit\WinPenKit\WinPenKit.csproj" />
  </ItemGroup>

</Project>
