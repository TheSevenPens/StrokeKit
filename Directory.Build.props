<Project>

  <!--
    One place for the settings both projects here share.

    net10.0-windows because WinPenKit targets it, and this kit takes a project reference on
    WinPenKit rather than a package. See the README for why that reference exists.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    SkiaSharp's version is not ours to choose. WinPenKit pins 3.119.4 and its samples all draw
    with it, so a figure measured against this kit has to come out of the same renderer or a
    comparison between the two compares renderers as well as code.

    A mismatch resolves quietly, because the nuspec constraints are minimums: core against an
    older dependency satisfies ">= x" and nothing warns. So the version is stated here once.

    Avalonia is pinned for the same reason and to the same source.
  -->
  <PropertyGroup>
    <SkiaSharpVersion>3.119.4</SkiaSharpVersion>
    <AvaloniaVersion>12.1.2</AvaloniaVersion>
  </PropertyGroup>

</Project>
