<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Avalonia half of this guide, shared by the applications that open a window.

    It exists because there is more than one of those now: the Lab, which draws synthetic
    strokes to show what the library does, and the Recorder, which captures real ones. The
    control that puts a Surface on screen is the same in both, and the second application is
    is what turned one control in one application into a shared thing rather than a copy.

    The library itself stays free of Avalonia on purpose (see its csproj), so this is the
    boundary where the framework enters.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>StrokeFieldGuide.Canvas</RootNamespace>
    <AssemblyName>StrokeFieldGuide.Canvas</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Skia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="SkiaSharp" Version="$(SkiaSharpVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\StrokeFieldGuide\StrokeFieldGuide.csproj" />

    <!--
      The pen backends live here rather than in an application because there is now more
      than one application that opens a session. WinPenKit.Avalonia is named rather than
      WinPenKit alone, because the Avalonia pointer session is one of the backends offered
      and it is the one that needs a Control.
    -->
    <ProjectReference Include="..\..\..\WinPenKit\WinPenKit.Avalonia\WinPenKit.Avalonia.csproj" />
  </ItemGroup>

</Project>
